# The link of the network the examples join: make a network in the JigJoy app (app.jigjoy.ai)
# and copy its invite link. Keep the quotes: without them, everything after # is read as a comment.
MOZAIK_INVITE="https://network.app.jigjoy.ai#nt_..."

# The model the agents run on, one of @jigjoy/mozaik-agent's models, and its provider's key.
MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
