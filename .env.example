# The invite link of the network the examples join. `npm run network` makes one.
MOZAIK_INVITE=

# The model the agents run on, one of @jigjoy/mozaik-agent's models, and its provider's key.
MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Only for `npm run network`. On the hosted network a network is made with a Mozaik Cloud API key.
# For a network you run yourself, set NETWORK_ORIGIN (http://localhost:3000) and leave the key empty.
MOZAIK_API_KEY=
# NETWORK_ORIGIN=http://localhost:3000
